// file: core/scanner.js
const fs = require('fs');
const { state, simpanLaporanAman } = require('./state');
const { jedaWaktu, denganBatasWaktu } = require('../utils/helpers');
const { logMinimal } = require('../utils/logger');

const cariAtribut = (node, namaAtribut) => {
    if (node?.attrs && node.attrs[namaAtribut]) return node.attrs[namaAtribut];
    if (Array.isArray(node?.content)) {
        for (let child of node.content) {
            if (typeof child === 'object') {
                const hasil = cariAtribut(child, namaAtribut);
                if (hasil) return hasil;
            }
        }
    }
    return null;
};

const cariTag = (node, namaTag) => {
    if (node?.tag === namaTag) return node;
    if (Array.isArray(node?.content)) {
        for (let child of node.content) {
            if (typeof child === 'object') {
                const hasil = cariTag(child, namaTag);
                if (hasil) return hasil;
            }
        }
    }
    return null;
};

const ekstrakTeks = (konten) => {
    if (!konten) return null;
    if (typeof konten === 'string') return konten;
    if (Buffer.isBuffer(konten)) return konten.toString('utf-8');
    if (konten instanceof Uint8Array) return Buffer.from(konten).toString('utf-8');
    return String(konten);
};

const jalankanScanner = async (sock) => {
    try {
        for (; state.gelombangIndex < state.gelombang.length; state.gelombangIndex++) {
            const peluruGelombang = state.gelombang[state.gelombangIndex];
            logMinimal('sistem', `scanning batch ${state.gelombangIndex + 1}/${state.gelombang.length} (${peluruGelombang.length} target)...`);

            try {
                const jidGelombang = peluruGelombang.map(n => `${n}@s.whatsapp.net`);
                const hasilWa = await denganBatasWaktu(sock.onWhatsApp(...jidGelombang), 15000);

                if (hasilWa && hasilWa.length > 0) {
                    const targetValid = hasilWa.filter(r => r.exists);
                    const targetBodong = hasilWa.filter(r => !r.exists);

                    targetBodong.forEach(r => {
                        state.statistik.bodong++;
                        const nomorBodong = r.jid.split('@')[0];
                        const nomorPlus = '+' + nomorBodong; 
                        // hapus push logBodong, cukup simpan objek mentah
                        state.targetBodong.push({ nomor: nomorPlus });
                    });

                    const janjiParalel = targetValid.map(async (res) => {
                        const nomorPlus = '+' + res.jid.split('@')[0]; 
                        let bizNode = null;
                        let kueriGagal = false;

                        try {
                            const rawQuery = {
                                tag: 'iq',
                                attrs: { to: 's.whatsapp.net', type: 'get', xmlns: 'w:biz' },
                                content: [{
                                    tag: 'business_profile',
                                    attrs: { v: '116' },
                                    content: [{ tag: 'profile', attrs: { jid: res.jid } }]
                                }]
                            };
                            bizNode = await denganBatasWaktu(sock.query(rawQuery), 5000);
                        } catch (e) {
                            kueriGagal = true;
                            if (!e.message || (!e.message.includes('waktu tunggu') && !e.message.includes('timeout'))) {
                                logMinimal('error', `raw query error [${nomorPlus}]:\n` + e.stack);
                            }
                        }

                        // jika kueri putus di tengah jalan, buang badan
                        if (kueriGagal) return null;

                        // deteksi kasta murni
                        let isBisnis = false;
                        let kastaAkun = 0;
                        let statusVerifikasi = "[personal]";

                        if (bizNode && bizNode.content) {
                            const nodeIdentity = cariTag(bizNode, 'biz_identity_info');
                            
                            // wajib ada tag identitas bisnis mutlak dan ada namanya (anti-siluman)
                            if (nodeIdentity && nodeIdentity.attrs && nodeIdentity.attrs.display_name) {
                                isBisnis = true;
                                statusVerifikasi = "[business reguler]";
                                const typeRaw = nodeIdentity.attrs.type || "smb";
                                const vlevel = nodeIdentity.attrs.vlevel || "unknown";
                                if (vlevel === "high" || typeRaw === "verified") {
                                    statusVerifikasi = "[official/verified]";
                                    kastaAkun = 2; 
                                } else if (typeRaw === "smb") {
                                    kastaAkun = 1; 
                                }
                            }
                        }
                        
                        let statusTarget;
                        let waktuBio;
                        try {
                            const statusRes = await denganBatasWaktu(sock.fetchStatus(res.jid), 5000);
                            if (statusRes && statusRes.status) {
                                statusTarget = statusRes.status;
                                if (statusRes.setAt) {
                                    const tgl = new Date(statusRes.setAt);
                                    waktuBio = `${String(tgl.getDate()).padStart(2, '0')}/${String(tgl.getMonth() + 1).padStart(2, '0')}/${tgl.getFullYear()}`;
                                }
                            }
                        } catch (e) {
                            if (!e.message || !e.message.includes('waktu tunggu')) {
                                logMinimal('error', `timeout fetch bio status [${nomorPlus}]:\n` + e.stack);
                            }
                        }

                        if (!isBisnis) {
                            return { 
                                tipe: 'personal', nomorPlus, bioFinal: statusTarget, waktuBio 
                            };
                        }

                        // jalur bisnis mutlak, variabel opsional set undefined
                        let displayName;
                        let infoBisnis = "(kosong)";
                        let descBisnis;
                        let website;
                        let email;
                        let waktuJoin; 
                        let zonaWaktu;
                        let statusCover;
                        let alamatFisik;
                        let kordinatGps;
                        let cartStatus;
                        let botStatus;

                        const nodeIdentityBiz = cariTag(bizNode, 'biz_identity_info');
                        if (nodeIdentityBiz && nodeIdentityBiz.attrs && nodeIdentityBiz.attrs.display_name) {
                            displayName = nodeIdentityBiz.attrs.display_name;
                        }

                        const nodeKategori = cariTag(bizNode, 'category');
                        const kategori = nodeKategori ? ekstrakTeks(nodeKategori.content) : "unknown";
                        infoBisnis = `${statusVerifikasi} | ${kategori}`;
                        
                        const nodeDesc = cariTag(bizNode, 'description');
                        if (nodeDesc) descBisnis = ekstrakTeks(nodeDesc.content);
                        const nodeEmail = cariTag(bizNode, 'email');
                        if (nodeEmail) email = ekstrakTeks(nodeEmail.content);
                        const nodeWebsite = cariTag(bizNode, 'website');
                        if (nodeWebsite) website = ekstrakTeks(nodeWebsite.content);
                        zonaWaktu = cariAtribut(bizNode, 'timezone') || undefined;
                        
                        const nodeAddress = cariTag(bizNode, 'address');
                        if (nodeAddress) alamatFisik = ekstrakTeks(nodeAddress.content);
                        
                        const nodeLat = cariTag(bizNode, 'latitude');
                        const nodeLon = cariTag(bizNode, 'longitude');
                        if (nodeLat && nodeLon) kordinatGps = `${ekstrakTeks(nodeLat.content)}, ${ekstrakTeks(nodeLon.content)}`;
                        
                        const adaCover = cariTag(bizNode, 'cover_photo') || cariAtribut(bizNode, 'cover_photo_id');
                        if (adaCover) statusCover = "ada";
                        
                        const nodeMemberText = cariTag(bizNode, 'member_since_text');
                        const nodeMemberTs = cariTag(bizNode, 'member_since_ts');
                        if (nodeMemberText) {
                            waktuJoin = ekstrakTeks(nodeMemberText.content);
                        } else if (nodeMemberTs) {
                            const tsStr = ekstrakTeks(nodeMemberTs.content);
                            if (tsStr && !isNaN(tsStr)) {
                                const d = new Date(parseInt(tsStr) * 1000);
                                const bulan = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                                waktuJoin = `Joined in ${bulan[d.getMonth()]}, ${d.getFullYear()}`;
                            }
                        }
                        
                        const nodeCart = cariTag(cariTag(bizNode, 'profile_options'), 'cart_enabled');
                        if (nodeCart && ekstrakTeks(nodeCart.content) === 'true') cartStatus = "aktif";
                        
                        const nodeAuto = cariTag(bizNode, 'automated_type');
                        if (nodeAuto && ekstrakTeks(nodeAuto.content) !== 'unknown') botStatus = "terdeteksi";

                        let bioFinal = descBisnis ? descBisnis : statusTarget;
                        
                        return { 
                            tipe: 'bisnis', nomorPlus, infoBisnis, bioFinal, waktuBio, website, email, 
                            zonaWaktu, waktuJoin, statusCover, displayName, alamatFisik, kordinatGps, 
                            cartStatus, botStatus, kastaAkun, statusVerifikasi 
                        };
                    });

                    const hasilParalel = await Promise.all(janjiParalel);
                    const hasilValid = hasilParalel.filter(Boolean);

                    hasilValid.forEach(data => {
                        state.statistik.terdaftar++; 

                        if (data.tipe === 'personal') {
                            state.statistik.personal++;
                            // hapus rakitan string panjang buat personal, cukup simpan objek mutlak
                            state.targetPersonal.push({
                                nomor: data.nomorPlus,
                                bio: data.bioFinal,
                                updateTerakhir: data.waktuBio
                            });
                            logMinimal('hit', `[${data.nomorPlus}] => personal reguler`);

                        } else if (data.tipe === 'bisnis') {
                            let formatBio = data.bioFinal ? data.bioFinal.replace(/\n/g, '\n     │             ') : undefined;
                            
                            let logData = `   • ${data.nomorPlus}\n`;
                            logData += `     ├─ nama      : ${data.displayName ? data.displayName : "(tanpa nama)"} ${data.statusVerifikasi}\n`;
                            logData += `     ├─ kategori  : ${data.infoBisnis}\n`;
                            if (data.waktuJoin) logData += `     ├─ bergabung : ${data.waktuJoin}\n`;
                            if (data.website) logData += `     ├─ website   : ${data.website}\n`;
                            if (data.email) logData += `     ├─ email     : ${data.email}\n`;
                            if (data.alamatFisik) logData += `     ├─ alamat    : ${data.alamatFisik}\n`;
                            if (data.kordinatGps) logData += `     ├─ gps       : ${data.kordinatGps}\n`;
                            if (data.zonaWaktu) logData += `     ├─ timezone  : ${data.zonaWaktu}\n`; 
                            
                            let arrBotCart = [];
                            if (data.cartStatus) arrBotCart.push("cart aktif");
                            if (data.botStatus) arrBotCart.push("bot terdeteksi");
                            if (arrBotCart.length > 0) logData += `     ├─ cart/bot  : ${arrBotCart.join(' / ')}\n`;
                            
                            if (data.statusCover) logData += `     ├─ cover     : ada\n`;
                            if (data.waktuBio) logData += `     ├─ update    : ${data.waktuBio}\n`;
                            if (formatBio) logData += `     ├─ bio/desc  : ${formatBio}\n`;
                            
                            let lines = logData.trimEnd().split('\n');
                            for (let i = lines.length - 1; i >= 0; i--) {
                                if (lines[i].includes('├─')) {
                                    lines[i] = lines[i].replace('├─', '└─');
                                    break;
                                }
                            }
                            logData = lines.join('\n');
                            
                            if (data.bioFinal) state.statistik.bioBisnis++; else state.statistik.tanpaBioBisnis++;

                            // hapus state.logBisnis.push, cukup simpan objek di targetBisnis
                            state.targetBisnis.push({
                                nomor: data.nomorPlus,
                                displayName: data.displayName,
                                timezone: data.zonaWaktu,
                                kategori: data.infoBisnis,
                                kasta: data.kastaAkun,
                                logString: logData, // ini masih dipertahankan buat di-map di state.js
                                website: data.website,
                                email: data.email,
                                bergabung: data.waktuJoin,
                                alamat: data.alamatFisik,
                                gps: data.kordinatGps,
                                cart: data.cartStatus,
                                bot: data.botStatus,
                                cover: data.statusCover,
                                bio: data.bioFinal,
                                updateTerakhir: data.waktuBio
                            });
                            
                            logMinimal('hit', `[${data.nomorPlus}] => ${data.statusVerifikasi}`);
                        }
                    });
                }
            } catch (e) {
                logMinimal('error', 'batch scanning terputus:\n' + e.stack);
                throw e; 
            }

            // saklar auto-save mutlak (kelipatan 10 atau gelombang pamungkas)
            const isKelipatan10 = (state.gelombangIndex + 1) % 10 === 0;
            const isTamat = state.gelombangIndex === state.gelombang.length - 1;

            if (isKelipatan10 || isTamat) {
                logMinimal('sistem', `[auto-save] menyortir dan menulis brankas (batch ${state.gelombangIndex + 1})...`);
                simpanLaporanAman();
            }

            if (state.gelombangIndex < state.gelombang.length - 1) {
                const jedaGelombang = Math.floor(Math.random() * (1000 - 500 + 1)) + 500;
                logMinimal('sistem', `cooling down ${jedaGelombang / 1000} detik...`);
                await jedaWaktu(jedaGelombang, jedaGelombang);
            }
        }

        logMinimal('selesai', `[report cekbio] bisnis: ${state.targetBisnis.length} | personal: ${state.statistik.personal} | bodong: ${state.statistik.bodong}++`);
        logMinimal('sistem', 'proses cekbio selesai.');
        console.log('\n[!] tekan ctrl+c untuk mematikan proses, lalu jalankan ulang script untuk kembali ke menu.');
        
        const namaBersih = state.fileAmunisiAktif ? state.fileAmunisiAktif.replace('.txt', '') : '';
        if (namaBersih && fs.existsSync(`posko_${namaBersih}.json`)) {
            fs.unlinkSync(`posko_${namaBersih}.json`);
        }
        
        sock.ws.close();
        sock.ev.removeAllListeners();
        return;

    } catch (e) {
        logMinimal('error', 'kegagalan fatal scanner:\n' + e.stack);
        state.mesinBerjalan = false;
        
        // airbag murni: paksa save sisa data di ram sebelum mati
        logMinimal('sistem', '[airbag] nyelamatin sisa data ke brankas...');
        simpanLaporanAman(); 
        
        process.exit(1);
    }
};

module.exports = { jalankanScanner };