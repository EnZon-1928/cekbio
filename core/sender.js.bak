// file: core/sender.js
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason, fetchLatestBaileysVersion } = require('@whiskeysockets/baileys');
const pino = require('pino');
const readline = require('readline');
const fs = require('fs');

const loggerPino = pino({ level: 'silent' });
const buatTanya = (rl) => (pertanyaan) => new Promise(resolve => rl.question(pertanyaan, resolve));

const catatLog = (pesan) => {
    try {
        const waktu = new Date().toLocaleString('id-ID');
        fs.appendFileSync('log.txt', `[${waktu}] ${pesan}\n`);
    } catch (e) {
        console.log('\n[!] error nulis log:\n' + e.stack);
    }
};

const cariSesiTertinggi = () => {
    try {
        const folderAda = fs.readdirSync('.').filter(f => f.startsWith('sesi_radar_'));
        if (folderAda.length === 0) return 1;
        const angkaSesi = folderAda.map(f => parseInt(f.replace('sesi_radar_', ''))).filter(n => !isNaN(n));
        return Math.max(...angkaSesi) + 1;
    } catch (e) {
        catatLog('error cari sesi: ' + e.stack);
        return 1;
    }
};

const tambahSender = async () => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const tanya = buatTanya(rl);
    
    try {
        const idBaru = cariSesiTertinggi();
        const folderBaru = `sesi_radar_${idBaru}`;
        console.log(`\nmenyiapkan sender baru di [${folderBaru}]...`);
        
        const { state, saveCreds } = await useMultiFileAuthState(folderBaru);
        
        const nomor = await tanya('masukkan nomor sender (contoh: 628xxx): ');
        const nomorBersih = nomor.replace(/\D/g, '');
        rl.close(); 
        
        let statusPairing = false; 

        const hubungkanMesin = async () => {
            const { version } = await fetchLatestBaileysVersion();
            
            const sock = makeWASocket({
                version,
                logger: loggerPino,
                printQRInTerminal: false,
                auth: state,
                browser: ['My Product', 'Chrome', '10.0'],
                companionPlatformDisplay: 'Chrome (Windows)'
            });

            sock.ev.on('creds.update', saveCreds);

            if (!sock.authState.creds.me?.id && !statusPairing) {
                try {
                    console.log('requesting pairing code... (jeda 3 detik)');
                    // nafas buatan 3 detik agar websocket open
                    await new Promise(resolve => setTimeout(resolve, 3000));
                    
                    const kode = await sock.requestPairingCode(nomorBersih);
                    statusPairing = true;
                    console.log(`\n[+] pairing code: ${kode}`);
                    console.log('menunggu sender merespon... (waktu maksimal 3 menit)');
                } catch (errPairing) {
                    catatLog(`gagal request pairing untuk ${nomorBersih}: ` + errPairing.stack);
                    console.log('\n[!] gagal request kode pairing. periksa sinyal atau log.txt');
                    return;
                }
            }

            return new Promise((resolve) => {
                let batasWaktu = setTimeout(() => {
                    catatLog(`[${folderBaru}] timeout. sender tidak merespon/terhubung dalam 180 detik.`);
                    console.log('\n[!] timeout. sender gagal terhubung (180s).');
                    sock.ws.close();
                    sock.ev.removeAllListeners();
                    resolve();
                }, 180000);

                sock.ev.on('connection.update', async (update) => {
                    const { connection, lastDisconnect } = update;
                    
                    if (connection === 'open') {
                        clearTimeout(batasWaktu);
                        console.log(`\n[+] Sender connected! sesi ${folderBaru} tersimpan.`);
                        sock.ws.close();
                        sock.ev.removeAllListeners();
                        resolve();
                    } else if (connection === 'close') {
                        const alasan = lastDisconnect?.error?.output?.statusCode;
                        const pesanError = lastDisconnect?.error?.message;
                        
                        catatLog(`[${folderBaru}] connection close. statuscode: ${alasan} | pesan: ${pesanError}`);
                        
                        if (alasan === DisconnectReason.loggedOut || alasan === 403 || alasan === 401) {
                            console.log(`\n[!] gagal. device dikeluarkan/banned (kode: ${alasan}).`);
                            clearTimeout(batasWaktu);
                            sock.ws.close();
                            sock.ev.removeAllListeners();
                            resolve();
                        } else {
                            catatLog(`[${folderBaru}] micro-disconnect (${alasan}). mengeksekusi reconnect otomatis...`);
                            
                            clearTimeout(batasWaktu);
                            sock.ws.close();
                            sock.ev.removeAllListeners();
                            
                            resolve(await hubungkanMesin());
                        }
                    }
                });
            });
        };

        await hubungkanMesin();

    } catch (e) {
        catatLog('error fatal tambah sender: ' + e.stack);
        console.log('\nerror fatal tambah sender, cek log.txt\n' + e.stack);
    }
};

const pingSender = async (folderSesi) => {
    return new Promise(async (resolve) => {
        try {
            console.log(`pinging [${folderSesi}]...`);
            const { state } = await useMultiFileAuthState(folderSesi);
            
            const cekKoneksi = async () => {
                const { version } = await fetchLatestBaileysVersion();
                const sock = makeWASocket({
                    version,
                    logger: loggerPino,
                    printQRInTerminal: false,
                    auth: state,
                    browser: ['My Product', 'Chrome', '10.0'],
                    companionPlatformDisplay: 'Chrome (Windows)'
                });

                return new Promise((res) => {
                    let batasWaktu = setTimeout(() => {
                        catatLog(`ping timeout untuk ${folderSesi}`);
                        sock.ws.close();
                        sock.ev.removeAllListeners();
                        res({ folder: folderSesi, status: 'timeout/mati' });
                    }, 15000);

                    sock.ev.on('connection.update', async (update) => {
                        const { connection, lastDisconnect } = update;
                        if (connection === 'open') {
                            clearTimeout(batasWaktu);
                            sock.ws.close();
                            sock.ev.removeAllListeners();
                            res({ folder: folderSesi, status: 'hidup' });
                        } else if (connection === 'close') {
                            const alasan = lastDisconnect?.error?.output?.statusCode;
                            if (alasan === DisconnectReason.loggedOut || alasan === 401 || alasan === 403) {
                                catatLog(`ping banned/logout untuk ${folderSesi}. statuscode: ${alasan}`);
                                clearTimeout(batasWaktu);
                                sock.ws.close();
                                sock.ev.removeAllListeners();
                                res({ folder: folderSesi, status: 'banned/logout' });
                            } else {
                                clearTimeout(batasWaktu);
                                sock.ws.close();
                                sock.ev.removeAllListeners();
                                res(await cekKoneksi());
                            }
                        }
                    });
                });
            };
            
            let timeoutGlobal;
            const hasilFinal = await Promise.race([
                cekKoneksi(),
                new Promise(r => {
                    timeoutGlobal = setTimeout(() => {
                        r({ folder: folderSesi, status: 'timeout/mati' });
                    }, 30000);
                })
            ]);
            clearTimeout(timeoutGlobal);
            resolve(hasilFinal);
            
        } catch (e) {
            catatLog(`error ping ${folderSesi}: ` + e.stack);
            resolve({ folder: folderSesi, status: 'error' });
        }
    });
};

const eksekusiIntelijenSender = async (mode, data) => {
    try {
        if (mode === 'semua') {
            const folderSesi = data;
            if (folderSesi.length === 0) return console.log('tidak ada sender.');
            for (let folder of folderSesi) {
                const hasil = await pingSender(folder);
                console.log(`  -> status: ${hasil.status}`);
            }
        } else if (mode === 'spesifik') {
            const folderTarget = `sesi_radar_${data}`;
            if (fs.existsSync(folderTarget)) {
                const hasil = await pingSender(folderTarget);
                console.log(`  -> status: ${hasil.status}`);
            } else {
                console.log(`[!] direktori ${folderTarget} tidak ditemukan.`);
            }
        } else if (mode === 'bersih') {
            const folderSesi = data;
            console.log('\nmemulai pembersihan sender mati...');
            for (let folder of folderSesi) {
                const hasil = await pingSender(folder);
                if (hasil.status === 'banned/logout' || hasil.status === 'timeout/mati') {
                    fs.rmSync(folder, { recursive: true, force: true });
                    console.log(`[+] ${folder} dihapus.`);
                } else {
                    console.log(`[-] ${folder} masih hidup, diamankan.`);
                }
            }
            console.log('pembersihan tuntas.');
        }
    } catch (e) {
        catatLog('error kelola sender: ' + e.stack);
    }
};

module.exports = { tambahSender, eksekusiIntelijenSender };
