// file: core/engine.js
const { default: makeWASocket, useMultiFileAuthState, fetchLatestBaileysVersion } = require('@whiskeysockets/baileys');
const pino = require('pino');
const readline = require('readline');
const fs = require('fs');

const { state } = require('./state');
const { jalankanScanner } = require('./scanner');

const loggerPino = pino({ level: 'silent' });
const buatTanya = (rl) => (pertanyaan) => new Promise(resolve => rl.question(pertanyaan, resolve));

const loadJsonAman = (pathFile) => {
    if (fs.existsSync(pathFile)) {
        try { return JSON.parse(fs.readFileSync(pathFile, 'utf-8')); } 
        catch (e) {
            console.log('\n[!] error baca json di ' + pathFile + ':\n' + e.stack);
            return []; 
        }
    }
    return [];
};

const resetStateMutlak = (isResume = false, namaBersih = '') => {
    if (!isResume) {
        state.targetBisnis = [];
        state.targetPersonal = [];
        state.targetBodong = [];
        state.logBisnis = [];
        state.logPersonal = [];
        state.logBodong = [];
        state.statistik = { terdaftar: 0, bodong: 0, bioBisnis: 0, tanpaBioBisnis: 0, personal: 0 }; 
        state.gelombangIndex = 0;
    } else {
        state.targetBisnis = loadJsonAman(`target_bisnis_${namaBersih}.json`);
        state.targetPersonal = loadJsonAman(`target_personal_${namaBersih}.json`);
        state.targetBodong = loadJsonAman(`target_bodong_${namaBersih}.json`);
        
        state.logBisnis = state.targetBisnis.map(item => item.logString).filter(Boolean);
        state.logBodong = state.targetBodong.map(item => `   • ${item.nomor}`);
        state.logPersonal = state.targetPersonal.map(data => {
            let formatBio = data.bio ? data.bio.replace(/\n/g, '\n     │             ') : undefined;
            
            let logData = `   • ${data.nomor}\n`;
            if (data.updateTerakhir) logData += `     ├─ update    : ${data.updateTerakhir}\n`;
            if (formatBio) logData += `     ├─ bio/desc  : ${formatBio}\n`;
            
            // rapihin dahan terakhir txt mutlak saat resume
            let lines = logData.trimEnd().split('\n');
            for (let i = lines.length - 1; i >= 0; i--) {
                if (lines[i].includes('├─')) {
                    lines[i] = lines[i].replace('├─', '└─');
                    break;
                }
            }
            return lines.join('\n');
        });
        
        // hitung ulang statistik murni tanpa bergantung string kosong
        state.statistik = {
            terdaftar: state.targetBisnis.length + state.targetPersonal.length,
            bodong: state.targetBodong.length,
            bioBisnis: state.targetBisnis.filter(b => b.bio).length,
            tanpaBioBisnis: state.targetBisnis.filter(b => !b.bio).length,
            personal: state.targetPersonal.length
        };
    }
    state.gelombang = [];
};

const jalankanMesin = async (kembaliKeMenu) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const tanya = buatTanya(rl);

    try {
        console.clear();
        console.log('=== starting cekbio ===');

        const listFileTxt = fs.readdirSync('.').filter(f => f.endsWith('.txt') && !f.includes('report_'));
        console.log('\n[ daftar file target ]');
        
        if (listFileTxt.length === 0) {
            console.log(' - tidak ada file target ditemukan.');
            console.log('kembali ke menu dalam 2 detik...');
            rl.close();
            return setTimeout(kembaliKeMenu, 2000);
        }

        listFileTxt.forEach((f, i) => console.log(`${i + 1}. ${f}`));
        console.log('0. batal dan kembali');
        
        const inputFile = await tanya(`\npilih nomor urut file target [0-${listFileTxt.length}]: `);
        const indexFile = parseInt(inputFile);

        if (inputFile === '0' || indexFile === 0) {
            rl.close();
            return kembaliKeMenu();
        }

        if (isNaN(indexFile) || indexFile < 1 || indexFile > listFileTxt.length) {
            console.log('\n[!] pilihan tidak valid.');
            rl.close();
            return setTimeout(kembaliKeMenu, 2000);
        }

        const fileTarget = listFileTxt[indexFile - 1];
        state.fileAmunisiAktif = fileTarget;
        const namaBersih = fileTarget.replace('.txt', '');

        let isResume = false;
        const poskoFile = `posko_${namaBersih}.json`;
        if (fs.existsSync(poskoFile)) {
            try {
                const tracker = JSON.parse(fs.readFileSync(poskoFile, 'utf-8'));
                console.log(`\n[!] jejak cekbio ditemukan untuk [${fileTarget}]`);
                console.log(`    (terakhir scan: batch ${tracker.gelombangIndex}/${tracker.totalGelombang})`);
                console.log('1. lanjutkan cekbio (resume dari titik terakhir)');
                console.log('2. hapus jejak (ulang dari awal)');
                console.log('0. batal');
                
                const pilihanResume = await tanya('pilih menu [0-2]: ');
                if (pilihanResume === '1') {
                    isResume = true;
                } else if (pilihanResume === '2') {
                    fs.unlinkSync(poskoFile);
                    isResume = false;
                } else {
                    rl.close();
                    return kembaliKeMenu();
                }
            } catch (e) {
                console.log('\n[!] error baca posko:\n' + e.stack);
                fs.unlinkSync(poskoFile);
            }
        }

        resetStateMutlak(isResume, namaBersih);
        if (isResume) {
            state.gelombangIndex = JSON.parse(fs.readFileSync(poskoFile, 'utf-8')).gelombangIndex;
        }

        const dataPeluru = fs.readFileSync(fileTarget, 'utf-8');
        const listNomor = dataPeluru.split('\n').map(n => n.replace(/\D/g, '')).filter(n => n.length > 5);
        
        if (listNomor.length === 0) {
            console.log('\n[!] file target kosong atau format salah.');
            rl.close();
            return setTimeout(kembaliKeMenu, 2000);
        }

        console.log(`\ninfo: ${listNomor.length} nomor siap di-scan.`);
        const ukuranGelombang = await tanya('masukkan jumlah nomor per batch (contoh: 50, ketik 0 batal): ');
        
        if (ukuranGelombang === '0') {
            rl.close();
            return kembaliKeMenu();
        }
        
        const limitGelombang = parseInt(ukuranGelombang) || 50;
        for (let i = 0; i < listNomor.length; i += limitGelombang) {
            state.gelombang.push(listNomor.slice(i, i + limitGelombang));
        }

        const listSesi = fs.readdirSync('.').filter(f => f.startsWith('sesi_radar_'));
        console.log('\n[ daftar sender aktif ]');
        
        if (listSesi.length === 0) {
            console.log(' - tidak ada sender. kembali dan rekrut dulu!');
            console.log('kembali ke menu dalam 2 detik...');
            rl.close();
            return setTimeout(kembaliKeMenu, 2000);
        }

        listSesi.forEach((f, i) => console.log(`${i + 1}. ${f.replace('sesi_radar_', 'sesi ')}`));
        console.log('0. batal dan kembali');

        const inputSesi = await tanya(`\npilih nomor urut sender [0-${listSesi.length}]: `);
        const indexSesi = parseInt(inputSesi);

        if (inputSesi === '0' || indexSesi === 0) {
            rl.close();
            return kembaliKeMenu();
        }

        if (isNaN(indexSesi) || indexSesi < 1 || indexSesi > listSesi.length) {
            console.log('\n[!] pilihan tidak valid.');
            rl.close();
            return setTimeout(kembaliKeMenu, 2000);
        }

        const folderSesi = listSesi[indexSesi - 1];

        console.log(`\nmenghubungkan sender [${folderSesi}]...`);
        rl.close();

        const { state: authState, saveCreds } = await useMultiFileAuthState(folderSesi);
        const { version } = await fetchLatestBaileysVersion();
        
        const sock = makeWASocket({
            version,
            logger: loggerPino,
            printQRInTerminal: false,
            auth: authState,
            browser: ['My Product', 'Chrome', '10.0'],
            companionPlatformDisplay: 'Chrome (Windows)'
        });

        sock.ev.on('creds.update', saveCreds);

        sock.ev.on('connection.update', async (update) => {
            const { connection } = update;
            if (connection === 'open') {
                console.log(`\n[+] sender terhubung. memulai proses cekbio!`);
                try {
                    await jalankanScanner(sock);
                } catch (e) {
                    console.log('error fatal saat memanggil scanner:\n' + e.stack);
                }
            } else if (connection === 'close') {
                console.log('\n[!] koneksi terputus. periksa kembali jaringan atau status sender.');
                process.exit(1);
            }
        });

    } catch (e) {
        console.log('\nerror fatal jembatan mesin:\n' + e.stack);
        rl.close();
        if (kembaliKeMenu) setTimeout(kembaliKeMenu, 3000);
    }
};

module.exports = { jalankanMesin };
