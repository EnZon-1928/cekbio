// file: index.js
const { exec } = require('child_process');
const { jalankanMenuUtama } = require('./io/menu');
const { state, simpanLaporanAman } = require('./core/state');

const isAndroid = process.platform === 'android';

// 1. sensor pintar: cuma jalan kalau os-nya android (termux)
if (isAndroid) {
    exec('termux-wake-lock', (err) => {
        if (!err) console.log('\n[+] sistem anti-tidur android (wakelock) aktif.');
    });
}

// 2. airbag global: sapu bersih & rem darurat saat ctrl+c ditekan
const remDarurat = () => {
    // paksa cetak sisa memori jika mesin sedang ngeradar amunisi
    if (state.fileAmunisiAktif) {
        console.log('\n[!] rem mendadak ditarik (ctrl+c).');
        console.log('[!] [airbag] nyelamatin sisa data di ram ke hardisk...');
        simpanLaporanAman();
    }

    if (isAndroid) {
        exec('termux-wake-unlock', () => {
            process.exit(0);
        });
    } else {
        process.exit(0);
    }
};

process.on('SIGINT', remDarurat); // nangkap ctrl+c mutlak

// penangkap ledakan error mutlak agar mesin tidak force close
process.on('uncaughtException', (e) => {
    console.log('\n[!] error fatal tidak tertangani:\n', e.stack);
});

process.on('unhandledRejection', (e) => {
    console.log('\n[!] janji ditolak mutlak:\n', e.stack);
});

// eksekusi masuk ke markas
jalankanMenuUtama();